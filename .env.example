# Copy to .env.local for local development. On Vercel, add the same keys under
# Project Settings -> Environment Variables.

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html (economic data, rates, mortgage rates).
FRED_API_KEY=

# Required by the SEC for automated requests (N-PORT fund holdings): your name and a contact email.
SEC_USER_AGENT=Your Name you@example.com
